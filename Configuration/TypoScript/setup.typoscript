# RSS News Import: override dei template Fluid di EXT:news.
# Fluid usa per ogni file il percorso con indice più alto che lo contiene,
# quindi tutti gli altri template di EXT:news restano invariati.
plugin.tx_news {
    view {
        templateRootPaths {
            150 = EXT:rss_news_import/Resources/Private/Extensions/News/Templates/
        }
        partialRootPaths {
            150 = EXT:rss_news_import/Resources/Private/Extensions/News/Partials/
        }
    }
}

page.includeCSS.rssNewsImport = EXT:rss_news_import/Resources/Public/Css/rss-news-import.css
