# RSS News Import: overrides of the EXT:news Fluid templates.
# For every file Fluid uses the path with the highest index that contains it,
# so all other EXT:news templates stay unchanged.
plugin.tx_news {
    view {
        templateRootPaths {
            150 = EXT:rssnewsimport/Resources/Private/Extensions/News/Templates/
        }
        partialRootPaths {
            150 = EXT:rssnewsimport/Resources/Private/Extensions/News/Partials/
        }
    }
}

page.includeCSS.rssNewsImport = EXT:rssnewsimport/Resources/Public/Css/rss-news-import.css
